# ============================================================
# POLYMARKET BTC 5-MINUTE PAPER TRADER
# Example configuration
#
# IMPORTANT:
# This file must NEVER contain real private keys or credentials.
# PAPER TRADING ONLY during the research phase.
# ============================================================


# ============================================================
# Polymarket Wallet
# ============================================================

# NEVER put a real private key into this file.
POLYMARKET_PK=

# Polymarket proxy/funder address.
# Leave empty for paper trading.
POLYMARKET_FUNDER=

# 0 = EOA
# 1 = POLY_PROXY
# 2 = POLY_GNOSIS_SAFE
POLYMARKET_SIG_TYPE=


# ============================================================
# Polymarket CLOB API Credentials
# ============================================================

# Leave empty during paper trading.
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_PASSPHRASE=


# ============================================================
# Ethereum / Polygon RPC
# ============================================================

# Leave empty until the data layer actually requires it.
ETH_RPC_URL=


# ============================================================
# Redis
# ============================================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0


# ============================================================
# Trading Parameters
# ============================================================

# Maximum paper position size.
MAX_POSITION_SIZE=1.0

# Paper market allocation in USD.
MARKET_BUY_USD=10.00


# ============================================================
# Stop Loss / Take Profit
# ============================================================

# false = stop loss disabled
# true  = stop loss enabled
#
# During the initial repository test this remains empty and
# therefore uses the application's own default handling.
ENABLE_STOP_LOSS=

STOP_LOSS_PCT=
TAKE_PROFIT_PCT=


# ============================================================
# Entry-price-scaled SL / TP
# ============================================================

SL_PCT_AT_MIN_ENTRY=
SL_PCT_AT_MAX_ENTRY=

TP_PCT_AT_MIN_ENTRY=
TP_PCT_AT_MAX_ENTRY=


# ============================================================
# Entry Price Band
# ============================================================

# Refuse entries outside this token-price range.
MIN_ENTRY_PRICE=
MAX_ENTRY_PRICE=


# ============================================================
# Spread Protection
# ============================================================

# Maximum allowed bid/ask spread as a fraction of mid price.
MAX_SPREAD_PCT=


# ============================================================
# Entry Timing
# ============================================================

# Minimum seconds between entry attempts.
ENTRY_COOLDOWN_SEC=

# Trade window inside each 5-minute market.
TRADE_WINDOW_SEC_START=
TRADE_WINDOW_SEC_END=

# Refuse new entries close to settlement.
LATE_ENTRY_CUTOFF_SEC=

# Cooldown after a pre-trade filter rejection.
FILTER_REJECT_COOLDOWN_SEC=


# ============================================================
# Per-Market Constraints
# ============================================================

# Lock the first direction for a market.
LOCK_MARKET_DIRECTION=

# Maximum number of entries per 5-minute market.
MAX_TRADES_PER_MARKET=

# Maximum allowed adverse price movement before re-entry.
MAX_CHASE_DELTA=

# Minimum fusion score for additional/pyramid entries.
PYRAMID_MIN_FUSION_SCORE=


# ============================================================
# Signal-Reversal Exit
# ============================================================

ENABLE_SIGNAL_REVERSAL_EXIT=

SIGNAL_REVERSAL_CHECK_SEC=

SIGNAL_REVERSAL_MIN_SCORE=

SIGNAL_REVERSAL_CONFIRM_COUNT=

SIGNAL_REVERSAL_ONLY_IF_LOSING=

SIGNAL_REVERSAL_GRACE_SEC=


# ============================================================
# Machine Learning
# ============================================================

# Minimum probability edge between ML prediction and
# Polymarket implied probability.
#
# Example:
#   ML p(UP)       = 0.68
#   Market         = 0.55
#   ML edge        = 0.13
#
# The supplied repository activates ML after its minimum
# training sample requirement has been reached.
MIN_ML_EDGE=


# ============================================================
# Signal Processor Thresholds
# ============================================================

SPIKE_THRESHOLD=
DIVERGENCE_THRESHOLD=


# ============================================================
# SAFETY
# ============================================================

# No live-trading credentials are configured here.
# No wallet is configured here.
# No private key is configured here.
#
# The research project starts in PAPER TRADING ONLY mode.
